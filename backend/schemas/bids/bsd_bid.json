{
  "title": "BSD Bid — заявка учасника",
  "description": "BSD Тіло заявки (bid) учасника процедури закупівлі",
  "type": "object",
  "required": ["bidders", "documents", "value"],
  "properties": {
    "bidders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["identifier", "address", "contactPoint"],
        "properties": {
          "identifier": {
            "type": "object",
            "required": ["id", "scheme", "legalName"],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                    "40912345",
                    "72645189",
                    "18937462",
                    "56283917",
                    "09471058",
                    "83716245",
                    "10593827",
                    "67482913",
                    "35129648",
                    "94582137"
                ]
                },
              "scheme": {
                "type": "string",
                "enum": ["UA-EDR", "AE-ACCI"]
              },
              "legalName": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 60
                  }
                }
              }
            }
          },
          "address": {
            "type": "object",
            "required": ["addressID", "streetAddress", "locality", "region", "countryName"],
            "properties": {
              "addressID": {
                "type": "object",
                "properties": {
                  "id": {
                    "example": "0120000000"
                  },
                  "scheme": {
                    "const": "koatuu"
                  }
                }
              },
              "streetAddress": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 50
                  }
                }
              },
              "locality": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 30
                  }
                }
              },
              "region": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string",
                    "enum": [
                      "Автономна Республіка Крим",
                      "Вінницька область",
                      "Волинська область",
                      "Дніпропетровська область",
                      "Донецька область",
                      "Житомирська область",
                      "Закарпатська область",
                      "Запорізька область",
                      "Івано-Франківська область",
                      "Київська область",
                      "Київ",
                      "Кіровоградська область",
                      "Луганська область",
                      "Львівська область",
                      "Миколаївська область",
                      "Одеська область",
                      "Полтавська область",
                      "Рівненська область",
                      "Севастополь",
                      "Сумська область",
                      "Тернопільська область",
                      "Харківська область",
                      "Херсонська область",
                      "Хмельницька область",
                      "Черкаська область",
                      "Чернівецька область",
                      "Чернігівська область"
                    ]
                  }
                }
              },
              "countryName": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "const": "Україна"
                  }
                }
              }
            }
          },
          "contactPoint": {
            "type": "object",
            "required": ["name", "telephone", "email"],
            "properties": {
              "name": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string"
                  }
                }
              },
              "telephone": {
                "type": "string",
                "format": "phone"
              },
              "faxNumber": {
                "type": "string",
                "format": "phone"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "url": {
                "type": "string",
                "format": "url"
              }
            }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "requireValues": {
        "field": "documentType",
        "values": ["commercialProposal", "x_registrationFeeApproval", "x_guaranteeApproval"]
      },
      "items": {
        "type": "object",
        "required": ["title", "description", "documentType", "documentOf", "token"],
        "properties": {
          "title": {
            "type": "object",
            "properties": {
              "uk_UA": {
                "type": "string",
                "minLength": 10,
                "maxLength": 60
              }
            }
          },
          "description": {
            "type": "object",
            "properties": {
              "uk_UA": {
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            }
          },
          "documentType": {
            "type": "string",
            "enum": [
              "commercialProposal",
              "x_registrationFeeApproval",
              "x_guaranteeApproval",
              "x_passport",
              "x_IPN"
            ]
          },
          "documentOf": {
            "const": "bid"
          },
          "token": {
            "const": "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsImtpZCI6ImRzIn0..llZ8XcsMoFZ1mvwj7AaBT_XYWLmK-QMUiA2IzkLo5o2eiB8wsbE2-zRegGjmhLgSXIXmuGZj0H02zGR1O_5o7A3Vq7OqmBNiSX6rWWhPBamjX3ifxZbsmJw-3QAvKmheHlYSr27ThnoFYtyBiPdJ_opk1HfHUatHqq-huzX1mZydMGKvrGn3YxkHqAO4X0_q-lfl8L_tm3ul1MLJ4nKIp4ypU50mVQWWiBIhAdlrSAvE5Wt6MeGIh1myuY6ZhXxzqaDDM0F6UNUNUoUr7NOHoNy2e2UTg9sbi_0tfVrVd7SRBIYlDkkvXbLgXjyd4-BlF9VUNKphtSnO4ZvTEtlgSDb9EgLqZ-zIMxbgo2Sa2ofgfvXlGKUQpc3YNZB7NGcKWeFx6EZ-4nzWPT_fjGkTNyy0i96wTfcoLsau0Qj37bOJ1m1AALGYcL8lxgkZqxRd3M1KaTwHcpfGvyuoriUdWCmv0O_FXEKB6_H7Sm7QS1Fm5IOpw0QtEmRajjvKNa9qw_wBr7VsmWUvzLYFw8NMSvetnzg9GnDUzzbO2yHfpDxNyzZojrL008TtTBhFgCVXwq9lamgs1ZziqkbokkWPnYCA_0IefXkJH2Aq0SO-kDHd7bGbuS05TSsPqAfCY1tbhEYtoRZgevjC6HrgPP6is3DAQcrbH8w_lZc5SlO6SC4"
          }
        }
      }
    },
    "value": {
      "type": "object",
      "required": ["currency", "amount"],
      "properties": {
        "currency": {
          "const": "UAH"
        },
        "amount": {
          "type": "number",
          "minimum": 1000000,
          "maximum": 10000000
        }
      }
    }
  }
}