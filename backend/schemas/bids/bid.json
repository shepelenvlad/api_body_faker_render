{
  "title": "Bid — заявка учасника",
  "description": "Тіло заявки (bid) учасника процедури закупівлі: дані учасника, документи заявки, цінова пропозиція",
  "type": "object",
  "required": ["bidders", "documents", "value"],
  "properties": {
    "bidders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["identifier", "address", "contactPoint"],
        "properties": {
          "identifier": {
            "type": "object",
            "required": ["id", "scheme", "legalName"],
            "properties": {
              "id": {
                "example": "40912345"
              },
              "scheme": {
                "type": "string",
                "enum": ["UA-EDR", "AE-ACCI"]
              },
              "legalName": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 60
                  }
                }
              }
            }
          },
          "address": {
            "type": "object",
            "required": ["addressID", "streetAddress", "locality", "region", "countryName"],
            "properties": {
              "addressID": {
                "type": "object",
                "properties": {
                  "id": {
                    "example": "0120000000"
                  },
                  "scheme": {
                    "const": "koatuu"
                  }
                }
              },
              "streetAddress": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 50
                  }
                }
              },
              "locality": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 30
                  }
                }
              },
              "region": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string",
                    "enum": [
                      "Автономна Республіка Крим",
                      "Вінницька область",
                      "Волинська область",
                      "Дніпропетровська область",
                      "Донецька область",
                      "Житомирська область",
                      "Закарпатська область",
                      "Запорізька область",
                      "Івано-Франківська область",
                      "Київська область",
                      "Київ",
                      "Кіровоградська область",
                      "Луганська область",
                      "Львівська область",
                      "Миколаївська область",
                      "Одеська область",
                      "Полтавська область",
                      "Рівненська область",
                      "Севастополь",
                      "Сумська область",
                      "Тернопільська область",
                      "Харківська область",
                      "Херсонська область",
                      "Хмельницька область",
                      "Черкаська область",
                      "Чернівецька область",
                      "Чернігівська область"
                    ]
                  }
                }
              },
              "countryName": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "const": "Україна"
                  }
                }
              }
            }
          },
          "contactPoint": {
            "type": "object",
            "required": ["name", "telephone", "email"],
            "properties": {
              "name": {
                "type": "object",
                "properties": {
                  "uk_UA": {
                    "type": "string"
                  }
                }
              },
              "telephone": {
                "type": "string",
                "format": "phone"
              },
              "faxNumber": {
                "type": "string",
                "format": "phone"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "url": {
                "type": "string",
                "format": "url"
              }
            }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "requireValues": {
        "field": "documentType",
        "values": ["commercialProposal", "x_registrationFeeApproval", "x_guaranteeApproval"]
      },
      "items": {
        "type": "object",
        "required": ["title", "description", "documentType", "documentOf", "token"],
        "properties": {
          "title": {
            "type": "object",
            "properties": {
              "uk_UA": {
                "type": "string",
                "minLength": 10,
                "maxLength": 60
              }
            }
          },
          "description": {
            "type": "object",
            "properties": {
              "uk_UA": {
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            }
          },
          "documentType": {
            "type": "string",
            "enum": [
              "commercialProposal",
              "x_registrationFeeApproval",
              "x_guaranteeApproval",
              "x_passport",
              "x_IPN"
            ]
          },
          "documentOf": {
            "const": "bid"
          },
          "token": {
            "type": "string"
          }
        }
      }
    },
    "value": {
      "type": "object",
      "required": ["currency", "amount"],
      "properties": {
        "currency": {
          "const": "UAH"
        },
        "amount": {
          "type": "number",
          "minimum": 1000,
          "maximum": 5000000
        }
      }
    }
  }
}
