{
  "title": "Renewables — Multi Awards Fast Manual",
  "description": "Аукціон з розподілу квоти підтримки відновлюваної енергетики (renewables-multiAwards-fast-manual)",
  "type": "object",
  "properties": {
    "sellingMethod": { "const": "renewables-multiAwards-fast-manual" },

    "auctionPeriod": {
      "type": "object",
      "properties": {
        "startDate": { "type": "string", "relativeHours": { "min": 24, "max": 72 } }
      },
      "required": ["startDate"]
    },

    "title": {
      "type": "object",
      "properties": {
        "uk_UA": { "type": "string", "minLength": 15, "maxLength": 120 },
        "en_US": { "type": "string", "minLength": 5, "maxLength": 60 }
      }
    },
    "description": {
      "type": "object",
      "properties": {
        "uk_UA": { "type": "string", "minLength": 15, "maxLength": 200 },
        "en_US": { "type": "string", "minLength": 5, "maxLength": 60 }
      }
    },

    "sellingEntity": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "object",
          "properties": {
            "id": { "example": "12345678" },
            "scheme": { "const": "UA-EDR" },
            "legalName": {
              "type": "object",
              "properties": {
                "uk_UA": { "type": "string", "minLength": 10, "maxLength": 80 },
                "en_US": { "type": "string", "minLength": 3, "maxLength": 40 }
              }
            }
          },
          "required": ["id", "legalName", "scheme"]
        },
        "address": {
          "type": "object",
          "properties": {
            "streetAddress": {
              "type": "object",
              "properties": {
                "uk_UA": { "type": "string", "minLength": 5, "maxLength": 50 },
                "en_US": { "type": "string", "minLength": 5, "maxLength": 50 }
              }
            },
            "locality": {
              "type": "object",
              "properties": {
                "uk_UA": { "type": "string", "minLength": 3, "maxLength": 30 },
                "en_US": { "type": "string", "minLength": 3, "maxLength": 30 }
              }
            },
            "region": {
              "type": "object",
              "properties": {
                "uk_UA": { "type": "string", "enum": ["Автономна Республіка Крим", "Вінницька область", "Волинська область", "Дніпропетровська область", "Донецька область", "Житомирська область", "Закарпатська область", "Запорізька область", "Івано-Франківська область", "Київська область", "Київ", "Кіровоградська область", "Луганська область", "Львівська область", "Миколаївська область", "Одеська область", "Полтавська область", "Рівненська область", "Севастополь", "Сумська область", "Тернопільська область", "Харківська область", "Херсонська область", "Хмельницька область", "Черкаська область", "Чернівецька область", "Чернігівська область"] },
                "en_US": { "type": "string", "minLength": 3, "maxLength": 30 }
              }
            },
            "postalCode": { "type": "string", "minLength": 5, "maxLength": 5 },
            "countryName": {
              "type": "object",
              "properties": {
                "uk_UA": { "const": "Україна" },
                "en_US": { "const": "Ukraine" }
              }
            }
          }
        },
        "contactPoint": {
          "type": "object",
          "properties": {
            "name": {
              "type": "object",
              "properties": {
                "uk_UA": { "type": "string", "minLength": 3, "maxLength": 40 },
                "en_US": { "type": "string", "minLength": 3, "maxLength": 40 }
              }
            },
            "telephone": { "type": "string", "format": "phone" },
            "faxNumber": { "type": "string", "format": "phone" },
            "email": { "type": "string", "format": "email" }
          }
        }
      }
    },

    "x_documentRequirements": {
      "type": "object",
      "properties": {
        "uk_UA": { "type": "string", "minLength": 10, "maxLength": 100 },
        "en_US": { "type": "string", "minLength": 5, "maxLength": 60 }
      }
    },
    "x_additionalInformation": {
      "type": "object",
      "properties": {
        "uk_UA": { "type": "string", "minLength": 10, "maxLength": 100 },
        "en_US": { "type": "string", "minLength": 5, "maxLength": 60 }
      }
    },
    "bankGuaranteeDetails": {
      "type": "object",
      "properties": {
        "uk_UA": { "type": "string", "minLength": 10, "maxLength": 100 },
        "en_US": { "type": "string", "minLength": 5, "maxLength": 60 }
      }
    },

    "value": {
      "type": "object",
      "properties": {
        "currency": { "const": "eurocent" },
        "amount": { "type": "number", "minimum": 1, "maximum": 100 }
      },
      "required": ["currency", "amount"]
    },
    "minimalStep": {
      "type": "object",
      "properties": {
        "currency": { "const": "eurocent" },
        "amount": { "type": "number", "minimum": 0.01, "maximum": 1 }
      }
    },

    "lotId": { "example": "UA-PS-19991212-00000" },
    "tenderAttempts": { "type": "integer", "enum": [1, 2] },

    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "object",
            "properties": {
              "uk_UA": { "type": "string", "minLength": 15, "maxLength": 100 },
              "en_US": { "type": "string", "minLength": 5, "maxLength": 60 }
            }
          },
          "classification": {
            "type": "object",
            "properties": {
              "scheme": { "const": "CAV" },
              "id": { "example": "09300000-2" }
            }
          },
          "additionalClassifications": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "scheme": { "const": "generationType" },
                "id": { "type": "string", "enum": ["01", "02", "03", "04", "05"] }
              }
            }
          },
          "unit": {
            "type": "object",
            "properties": { "code": { "const": "KWT" } }
          },
          "quantity": { "type": "integer", "minimum": 1000, "maximum": 100000000 }
        },
        "required": ["description", "classification", "unit", "quantity"]
      }
    },

    "documents": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueBy": "documentType",
      "requireValues": { "field": "documentType", "values": ["contractProforma"] },
      "items": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "title": {
            "type": "object",
            "properties": {
              "uk_UA": { "type": "string", "minLength": 3, "maxLength": 40 },
              "en_US": { "type": "string", "minLength": 3, "maxLength": 40 }
            }
          },
          "description": {
            "type": "object",
            "properties": {
              "uk_UA": { "type": "string", "minLength": 3, "maxLength": 40 },
              "en_US": { "type": "string", "minLength": 3, "maxLength": 40 }
            }
          },
          "documentOf": { "const": "auction" },
          "documentType": { "type": "string", "enum": ["contractProforma", "evaluationCriteria", "x_lotInfoEN"] }
        },
        "required": ["token", "title", "documentOf"]
      }
    }
  },
  "required": ["sellingMethod", "auctionPeriod", "title", "value", "items"]
}