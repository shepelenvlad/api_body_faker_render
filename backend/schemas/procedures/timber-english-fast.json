{
  "title": "Timber — English Fast",
  "description": "Лот продажу деревини / лісоматеріалів (timber-english-fast)",
  "type": "object",
  "properties": {
    "sellingMethod": { "const": "timber-english-fast" },

    "auctionPeriod": {
      "type": "object",
      "properties": {
        "startDate": { "type": "string", "relativeHours": { "min": 24, "max": 72 } }
      },
      "required": ["startDate"]
    },

    "sellingEntity": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "object",
          "properties": {
            "id": { "example": "12345678" },
            "legalName": {
              "type": "object",
              "properties": {
                "uk_UA": { "type": "string", "minLength": 10, "maxLength": 60 },
                "en_US": { "type": "string", "default": "" }
              }
            },
            "scheme": { "const": "UA-EDR" }
          },
          "required": ["id", "legalName", "scheme"]
        },
        "address": {
          "type": "object",
          "properties": {
            "addressID": {
              "type": "object",
              "properties": {
                "id": { "example": "4600000000" },
                "scheme": { "const": "koatuu" }
              }
            },
            "streetAddress": {
              "type": "object",
              "properties": { "uk_UA": { "type": "string", "minLength": 10, "maxLength": 50 } }
            },
            "locality": {
              "type": "object",
              "properties": { "uk_UA": { "type": "string", "minLength": 3, "maxLength": 30 } }
            },
            "region": {
              "type": "object",
              "properties": { "uk_UA": { "type": "string", "enum": ["Автономна Республіка Крим", "Вінницька область", "Волинська область", "Дніпропетровська область", "Донецька область", "Житомирська область", "Закарпатська область", "Запорізька область", "Івано-Франківська область", "Київська область", "Київ", "Кіровоградська область", "Луганська область", "Львівська область", "Миколаївська область", "Одеська область", "Полтавська область", "Рівненська область", "Севастополь", "Сумська область", "Тернопільська область", "Харківська область", "Херсонська область", "Хмельницька область", "Черкаська область", "Чернівецька область", "Чернігівська область"] } }
            },
            "countryName": {
              "type": "object",
              "properties": { "uk_UA": { "const": "Україна" } }
            }
          }
        },
        "contactPoint": {
          "type": "object",
          "properties": {
            "name": {
              "type": "object",
              "properties": { "uk_UA": { "type": "string" } }
            },
            "telephone": { "type": "string", "format": "phone" },
            "faxNumber": { "type": "string", "format": "phone" },
            "email": { "type": "string", "format": "email" },
            "url": { "type": "string", "format": "url" }
          }
        },
        "representativeInfo": { "type": "string", "minLength": 20, "maxLength": 150 }
      }
    },

    "title": {
      "type": "object",
      "properties": { "uk_UA": { "type": "string", "minLength": 10, "maxLength": 120 } }
    },
    "description": {
      "type": "object",
      "properties": { "uk_UA": { "type": "string", "minLength": 10, "maxLength": 200 } }
    },
    "accessDetails": {
      "type": "object",
      "properties": {
        "uk_UA": { "type": "string", "minLength": 10, "maxLength": 100 },
        "en_US": { "type": "string", "minLength": 5, "maxLength": 60 }
      }
    },

    "x_documentRequirements": {
      "type": "object",
      "properties": { "uk_UA": { "type": "string", "minLength": 10, "maxLength": 100 } }
    },
    "x_additionalInformation": {
      "type": "object",
      "properties": { "uk_UA": { "type": "string", "minLength": 10, "maxLength": 100 } }
    },

    "value": {
      "type": "object",
      "properties": {
        "currency": { "const": "UAH" },
        "amount": { "type": "number", "minimum": 100, "maximum": 500000 },
        "valueAddedTaxIncluded": { "type": "boolean" }
      },
      "required": ["currency", "amount"]
    },
    "guarantee": {
      "type": "object",
      "properties": {
        "currency": { "const": "UAH" },
        "amount": { "type": "number", "minimum": 500, "maximum": 20000 }
      }
    },
    "minimalStep": {
      "type": "object",
      "properties": {
        "currency": { "const": "UAH" },
        "amount": { "type": "number", "minimum": 10, "maximum": 1000 }
      }
    },
    "tenderAttempts": { "type": "integer", "enum": [1, 2] },

    "discount": {
      "type": "object",
      "properties": {
        "discount": { "type": "boolean" }
      },
      "if": {
        "properties": { "discount": { "const": true } }
      },
      "then": {
        "properties": {
          "previousAuctionValue": {
            "type": "object",
            "properties": {
              "currency": { "const": "UAH" },
              "amount": { "type": "number", "minimum": 100, "maximum": 500000 }
            }
          },
          "discountPercent": { "type": "number", "minimum": 1, "maximum": 50 }
        }
      }
    },

    "lotId": { "example": "UA-PS-11223344-00000" },

    "bankAccount": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "bankName": {
            "type": "object",
            "properties": {
              "uk_UA": { "type": "string", "minLength": 5, "maxLength": 40 },
              "en_US": { "type": "string", "default": "" }
            }
          },
          "description": {
            "type": "object",
            "properties": {
              "uk_UA": { "type": "string", "minLength": 10, "maxLength": 80 },
              "en_US": { "type": "string", "default": "" }
            }
          },
          "accountIdentifications": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": { "example": "UA773204780000000002600934039" },
                "scheme": { "const": "UA-IBAN" }
              }
            }
          },
          "paymentPurpose": {
            "type": "object",
            "properties": {
              "uk_UA": { "type": "string", "minLength": 10, "maxLength": 60 },
              "en_US": { "type": "string", "minLength": 5, "maxLength": 40 }
            }
          },
          "accountHolder": {
            "type": "object",
            "properties": {
              "identifier": {
                "type": "object",
                "properties": {
                  "id": { "example": "12312312" },
                  "scheme": { "const": "UA-EDR" },
                  "legalName": {
                    "type": "object",
                    "properties": { "uk_UA": { "type": "string", "minLength": 10, "maxLength": 60 } }
                  }
                }
              }
            }
          }
        }
      }
    },

    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "object",
            "properties": { "uk_UA": { "type": "string", "minLength": 10, "maxLength": 100 } }
          },
          "classification": {
            "type": "object",
            "properties": {
              "scheme": { "const": "CAV" },
              "id": { "example": "03410000-7" }
            }
          },
          "additionalClassifications": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "uniqueBy": "scheme",
            "items": {
              "type": "object",
              "properties": {
                "scheme": { "type": "string", "enum": ["timberProductionYear", "timberProductionQuarter", "timberSortment", "timberLength", "timberStorage", "timberDiameter", "timberSpecies", "CPVS", "timberClass"] },
                "id": { "type": "string", "minLength": 1, "maxLength": 10 }
              }
            }
          },
          "unit": {
            "type": "object",
            "properties": { "code": { "const": "MTQ" } }
          },
          "unitValue": {
            "type": "object",
            "properties": {
              "currency": { "const": "UAH" },
              "amount": { "type": "number", "minimum": 1, "maximum": 5000 }
            }
          },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "address": {
            "type": "object",
            "properties": {
              "addressID": {
                "type": "object",
                "properties": {
                  "id": { "example": "4600000000" },
                  "scheme": { "const": "koatuu" }
                }
              },
              "streetAddress": {
                "type": "object",
                "properties": { "uk_UA": { "type": "string", "minLength": 10, "maxLength": 50 } }
              },
              "locality": {
                "type": "object",
                "properties": { "uk_UA": { "type": "string", "minLength": 3, "maxLength": 30 } }
              },
              "region": {
                "type": "object",
                "properties": { "uk_UA": { "type": "string", "enum": ["Автономна Республіка Крим", "Вінницька область", "Волинська область", "Дніпропетровська область", "Донецька область", "Житомирська область", "Закарпатська область", "Запорізька область", "Івано-Франківська область", "Київська область", "Київ", "Кіровоградська область", "Луганська область", "Львівська область", "Миколаївська область", "Одеська область", "Полтавська область", "Рівненська область", "Севастополь", "Сумська область", "Тернопільська область", "Харківська область", "Херсонська область", "Хмельницька область", "Черкаська область", "Чернівецька область", "Чернігівська область"] } }
              },
              "countryName": {
                "type": "object",
                "properties": { "uk_UA": { "const": "Україна" } }
              }
            }
          }
        },
        "required": ["description", "classification", "unit", "quantity"]
      }
    },

    "documents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueBy": "documentType",
      "items": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "title": {
            "type": "object",
            "properties": {
              "uk_UA": { "type": "string", "minLength": 5, "maxLength": 60 },
              "en_US": { "type": "string", "minLength": 5, "maxLength": 40 }
            }
          },
          "description": {
            "type": "object",
            "properties": {
              "uk_UA": { "type": "string", "minLength": 5, "maxLength": 60 },
              "en_US": { "type": "string", "minLength": 5, "maxLength": 40 }
            }
          },
          "documentOf": { "const": "auction" },
          "documentType": { "type": "string", "enum": ["notice", "technicalSpecifications", "evaluationCriteria", "contractProforma", "x_presentation"] },
          "index": { "type": "integer", "minimum": 1, "maximum": 50 },
          "format": { "type": "string", "enum": ["application/pdf", "application/msword", "image/jpeg", "image/png"] },
          "language": { "type": "integer", "enum": [0] }
        },
        "required": ["token", "title", "documentOf"]
      }
    }
  },
  "if": {
    "properties": { "tenderAttempts": { "const": 1 } }
  },
  "then": {},
  "else": {
    "properties": {
      "previousAuctionId": { "example": "UA-PS-1122-33-44-000000-0" }
    }
  },
  "required": ["sellingMethod", "auctionPeriod", "title", "value", "items"]
}