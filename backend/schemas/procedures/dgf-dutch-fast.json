          "unit": { "type": "object", "properties": { "code": { "const": "H87" } } },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "address": {
            "type": "object",
            "properties": {
              "addressID": {
                "type": "object",
                "properties": {
                  "id": { "example": "4600000000" },
